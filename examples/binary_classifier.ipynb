   "source": [
    "import motorch\n",
    "import motorch.nn as nn\n",
    "import motorch.nn.functional as F\n",
    "import numpy as np\n",
    "\n",
    "x = np.array([1, 2, 3], dtype=np.float32)\n",
    "\n",
    "y = F.sigmoid(x)\n",
    "\n",
    "print(y)\n",
    "\n",
    "logloss = nn.LogisticLoss()\n",
    "sgn_fn = nn.Sgn()\n",
    "\n",
    "print(logloss, sgn_fn)"
   ]
  }
 ],
